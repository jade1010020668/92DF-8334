# ============================================================
# PLANTILLA DE CONFIGURACION SECRETA
# ============================================================
# 1. Copia este archivo como ".env" (sin el .ejemplo) en la misma carpeta.
# 2. Llena cada valor con los datos reales.
# 3. Nunca subas el archivo ".env" a git. El .gitignore ya lo bloquea.
# 4. Si alguno de estos valores aparece en una captura, chat o repo publico,
#    rotalo INMEDIATAMENTE en su consola correspondiente.
# ============================================================

# --- Gemini (Google AI Studio) ---
# Obtener en: https://aistudio.google.com/apikey
# La clave empieza con "AIza..." y tiene unos 40 caracteres.
GEMINI_API_KEY=

# --- Gmail (correo emisor de cotizaciones) ---
# El correo desde el que se enviaran las cotizaciones.
GMAIL_USUARIO=

# App Password de Gmail (NO la contrasena normal).
# Generar en: https://myaccount.google.com/apppasswords
# Requiere tener activado 2FA en la cuenta de Google.
# Formato: 16 caracteres, sin espacios.
GMAIL_APP_PASSWORD=

# --- WhatsApp (notificaciones al papa) ---
# Numero del papa con codigo de pais, sin espacios ni guiones.
# Ejemplo: +573001234567
WHATSAPP_NUMERO_PAPA=

# --- Acceso a pantalla de Configuracion ---
# PIN de 4 digitos. Solo Diego lo conoce.
CONFIG_PIN=
